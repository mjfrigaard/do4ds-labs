    VetMod --> VPW["<code>vetiver_pin_write()</code>"]
    VPW --> Joblib["Serialized <code>.joblib</code>"]
    VPW --> Meta["Metadata <code>.txt</code>"]
    
    Rep["To reproduce"] --> VPR["<code>vetiver_pin_read()</code>"]
    VPR --> Joblib
    VPR --> Meta
    VPR --> Recon["Reconstructed<br><code>VetiverModel()</code>"]
    
    style Mod fill:#FFF,stroke:#4CBB9D,color:#000,stroke-width:3px,rx:10,ry:10,font-size:16px
